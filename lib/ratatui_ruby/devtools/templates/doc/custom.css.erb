img {
  max-width: 100%;
  height: auto;
}

.theme-toggle {
  margin-left: 0 !important;
}

/* Terminal Previews (Native PNGs)
 * The images already contain the window chrome and shadows.
 * We just need to center them and ensure they scale down on mobile.
 */
img[src*="images/"] {
  display: block;
  margin: 2em auto;
}
